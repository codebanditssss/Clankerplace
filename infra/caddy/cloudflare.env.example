# Lives on the VM at /etc/caddy/cloudflare.env, mode 0640 root:caddy.
# Loaded into Caddy via /etc/systemd/system/caddy.service.d/cloudflare.conf
# (EnvironmentFile=). Referenced inside Caddyfile as {env.CF_API_TOKEN}.
#
# Token requirements: Cloudflare zone-scoped, Zone:DNS:Edit on bigcat.pw
# (or whatever PODS_DOMAIN_ROOT is). Mint via Cloudflare → My Profile →
# API Tokens → "Edit zone DNS" template.
CF_API_TOKEN=cfut_REPLACE_ME
