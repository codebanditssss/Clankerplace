[Unit]
Description=FuelBorn Next.js frontend
After=network.target

[Service]
Type=simple
User=podsadmin
SupplementaryGroups=docker
WorkingDirectory=/srv/pods/frontend
EnvironmentFile=/srv/pods/frontend/.env.local
ExecStart=/usr/bin/pnpm start
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
